
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model post {
  id        String   @id @default(uuid()) 
  title     String
  price  Int
  img  String
  address String
  city  String
  bedroom   Int
  bathroom  Int
  latitude  String
  longitude String
  Type Type
  Property Property
  createdAt DateTime @default(now())
  user User @relation()
  userId String @db.ObjectId
}

enum Type{
  buy
  rent
}

enum Property{
  apartment
  house
  condo
  land
}

